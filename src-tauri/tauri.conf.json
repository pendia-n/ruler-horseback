{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rulerhorseback",
  "version": "0.1.0",
  "identifier": "com.rulerhorseback.desktop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "title": "rulerhorseback",
        "width": 900,
        "height": 680,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.13"
    }
  }
}
